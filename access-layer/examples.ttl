@prefix ex: <https://ul.edu.lb/kr/guelph/examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:1 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "How many trips does route 1 have?" ;
    sh:select """PREFIX gtfs: <http://vocab.gtfs.org/terms#>
SELECT (COUNT(?trip) AS ?trips) WHERE {
  ?trip gtfs:route ?route .
  ?route gtfs:shortName "1" .
}""" .

ex:2 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which routes run on Saturday?" ;
    sh:select """PREFIX gtfs: <http://vocab.gtfs.org/terms#>
SELECT DISTINCT ?route WHERE {
  ?trip gtfs:route/gtfs:shortName ?route ;
        gtfs:service/gtfs:serviceRule/gtfs:saturday true .
}""" .

ex:3 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which stops does route 99 serve, with their names?" ;
    sh:select """PREFIX gtfs: <http://vocab.gtfs.org/terms#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?stop ?name WHERE {
  ?stopTime gtfs:trip/gtfs:route/gtfs:shortName "99" ;
            gtfs:stop ?stop .
  ?stop rdfs:label ?name .
}""" .

ex:4 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which trips of route 1 are wheelchair accessible?" ;
    sh:select """PREFIX gtfs: <http://vocab.gtfs.org/terms#>
SELECT ?trip WHERE {
  ?trip gtfs:route/gtfs:shortName "1" ;
        gtfs:wheelchairAccessible gtfs:WheelchairAccessible .
}""" .

ex:5 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Where is the stop Gordon at Kortright southbound?" ;
    sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
SELECT ?lat ?long WHERE {
  ?stop rdfs:label "Gordon at Kortright southbound" ;
        geo:lat ?lat ; geo:long ?long .
}""" .

ex:6 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "At what time does trip 465524 arrive at each of its stops?" ;
    sh:select """PREFIX gtfs: <http://vocab.gtfs.org/terms#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?order ?name ?arrival WHERE {
  ?stopTime gtfs:trip <https://ul.edu.lb/kr/id/trip/guelph/465524> ;
            gtfs:stopSequence ?order ; gtfs:arrivalTime ?arrival ;
            gtfs:stop/rdfs:label ?name .
} ORDER BY ?order""" .

ex:7 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "How many trips does each route have on weekdays (Monday)?" ;
    sh:select """PREFIX gtfs: <http://vocab.gtfs.org/terms#>
SELECT ?route (COUNT(?trip) AS ?trips) WHERE {
  ?trip gtfs:route/gtfs:shortName ?route ;
        gtfs:service/gtfs:serviceRule/gtfs:monday true .
} GROUP BY ?route ORDER BY ?route""" .

ex:8 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which routes stop at Gordon at Harts northbound?" ;
    sh:select """PREFIX gtfs: <http://vocab.gtfs.org/terms#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?route WHERE {
  ?stopTime gtfs:stop/rdfs:label "Gordon at Harts northbound" ;
            gtfs:trip/gtfs:route/gtfs:shortName ?route .
}""" .