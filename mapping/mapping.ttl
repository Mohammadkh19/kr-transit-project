## mapping.ttl: the Guelph GTFS tables (data/example.sql) mapped to our
## ontology (ontology/ontology.ttl), in R2RML. pipeline/run.py runs it with
## Morph-KGC. One block per kind of thing; every thing gets its IRI from one
## template: https://ul.edu.lb/kr/id/<kind>/guelph/<GTFS id>.
@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix gtfs: <http://vocab.gtfs.org/terms#> .

## Agency: one row of agency.txt
<#Agency>
    rr:logicalTable [ rr:tableName "agency" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/agency/guelph/{agency_id}" ; rr:class gtfs:Agency ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "agency_name" ] ] .

## Routes: one row of routes.txt, one bus line
<#Routes>
    rr:logicalTable [ rr:tableName "routes" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/route/guelph/{route_id}" ; rr:class gtfs:Route ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:shortName ; rr:objectMap [ rr:column "route_short_name" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:longName ; rr:objectMap [ rr:column "route_long_name" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:agency ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/agency/guelph/{agency_id}" ] ] .

## route_type 3 means bus (GTFS); Linked GTFS has a fixed value for it
<#BusRoutes>
    rr:logicalTable [ rr:sqlQuery """SELECT route_id FROM routes WHERE route_type = '3'""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/route/guelph/{route_id}" ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:routeType ; rr:object gtfs:Bus ] .

## Trips: one row of trips.txt, one bus journey
<#Trips>
    rr:logicalTable [ rr:tableName "trips" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/trip/guelph/{trip_id}" ; rr:class gtfs:Trip ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:headsign ; rr:objectMap [ rr:column "trip_headsign" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:route ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/route/guelph/{route_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:service ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/service/guelph/{service_id}" ] ] .

## wheelchair_accessible: 1 = yes, 2 = no, empty = no information (no triple)
<#AccessibleTrips>
    rr:logicalTable [ rr:sqlQuery """SELECT trip_id FROM trips WHERE wheelchair_accessible = '1'""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/trip/guelph/{trip_id}" ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:wheelchairAccessible ; rr:object gtfs:WheelchairAccessible ] .

<#NotAccessibleTrips>
    rr:logicalTable [ rr:sqlQuery """SELECT trip_id FROM trips WHERE wheelchair_accessible = '2'""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/trip/guelph/{trip_id}" ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:wheelchairAccessible ; rr:object gtfs:NotWheelchairAccessible ] .

## Services and their calendar rule: one row of calendar.txt gives both.
## GTFS writes days as 1/0; we write true/false.
<#Services>
    rr:logicalTable [ rr:tableName "calendar" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/service/guelph/{service_id}" ; rr:class gtfs:Service ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:serviceRule ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/calendar/guelph/{service_id}" ] ] .

<#CalendarRules>
    rr:logicalTable [ rr:sqlQuery """
        SELECT service_id,
          CASE monday    WHEN '1' THEN 'true' ELSE 'false' END AS mon,
          CASE tuesday   WHEN '1' THEN 'true' ELSE 'false' END AS tue,
          CASE wednesday WHEN '1' THEN 'true' ELSE 'false' END AS wed,
          CASE thursday  WHEN '1' THEN 'true' ELSE 'false' END AS thu,
          CASE friday    WHEN '1' THEN 'true' ELSE 'false' END AS fri,
          CASE saturday  WHEN '1' THEN 'true' ELSE 'false' END AS sat,
          CASE sunday    WHEN '1' THEN 'true' ELSE 'false' END AS sun
        FROM calendar""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/calendar/guelph/{service_id}" ; rr:class gtfs:CalendarRule ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:monday ;    rr:objectMap [ rr:column "mon" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:tuesday ;   rr:objectMap [ rr:column "tue" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:wednesday ; rr:objectMap [ rr:column "wed" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:thursday ;  rr:objectMap [ rr:column "thu" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:friday ;    rr:objectMap [ rr:column "fri" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:saturday ;  rr:objectMap [ rr:column "sat" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:sunday ;    rr:objectMap [ rr:column "sun" ; rr:datatype xsd:boolean ] ] .

## Stops: one row of stops.txt
<#Stops>
    rr:logicalTable [ rr:tableName "stops" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/stop/guelph/{stop_id}" ; rr:class gtfs:Stop ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "stop_name" ] ] ;
    rr:predicateObjectMap [ rr:predicate geo:lat ; rr:objectMap [ rr:column "stop_lat" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate geo:long ; rr:objectMap [ rr:column "stop_lon" ; rr:datatype xsd:decimal ] ] .

## Stop times: one row of stop_times.txt, "this trip is at this stop at this time".
## Times stay text: GTFS allows hours past 24 (25:10:00), which xsd:time does not.
<#StopTimes>
    rr:logicalTable [ rr:tableName "stop_times" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/stoptime/guelph/{trip_id}-{stop_sequence}" ; rr:class gtfs:StopTime ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:trip ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/trip/guelph/{trip_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:stop ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/stop/guelph/{stop_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:stopSequence ; rr:objectMap [ rr:column "stop_sequence" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:arrivalTime ; rr:objectMap [ rr:column "arrival_time" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:departureTime ; rr:objectMap [ rr:column "departure_time" ] ] ;
    rr:predicateObjectMap [ rr:predicate gtfs:distanceTraveled ; rr:objectMap [ rr:column "shape_dist_traveled" ; rr:datatype xsd:decimal ] ] .